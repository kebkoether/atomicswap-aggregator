# Stellar Network — defaults match the server's testnet defaults.
# For mainnet use:
#   SOROBAN_RPC_URL=<your RPC provider — SDF runs no free public mainnet RPC>
#   HORIZON_URL=https://horizon.stellar.org
#   NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Contract Addresses (deploy and fill in)
SWAPBOOK_CONTRACT_ID=
ROUTER_CONTRACT_ID=
FEE_VAULT_CONTRACT_ID=
AQUA_ADAPTER_CONTRACT_ID=
# Do NOT set until SushiSwap's Soroban ABI is verified (adapter is a placeholder)
SUSHI_ADAPTER_CONTRACT_ID=

# External DEX Contracts
# Aqua router mainnet: CBQDHNBFBZYE4MKPWBSJOPIYLW4SFSXAXUTSXJN76GNKYVYPCKWC6QUK
# Aqua router testnet: CDGX6Q3ZZIDSX2N3SHBORWUIEG2ZZEBAAMYARAXTT7M5L6IXKNJMT3GB
AQUA_ROUTER_CONTRACT=CDGX6Q3ZZIDSX2N3SHBORWUIEG2ZZEBAAMYARAXTT7M5L6IXKNJMT3GB
AQUA_API_URL=https://amm-api-testnet.aqua.network/api/external/v1

# Database
DATABASE_URL=postgresql://localhost:5432/atomicswap

# Redis
REDIS_URL=redis://localhost:6379

# Server
PORT=3001
WS_PORT=3002

# CORS — comma-separated origins allowed to call this API
CORS_ORIGIN=http://localhost:3000,https://your-app.vercel.app

# ─── Service keys (keep out of git; use your platform's secret store) ───

# Signs update_oracle_price transactions. Must match the on-chain
# oracle admin set via SwapBook.set_oracle_admin. Omit to run the
# oracle in cache-only mode (no on-chain pushes).
ORACLE_SECRET_KEY=

# Signs route_expired_order keeper transactions. This key holds NO
# custody and NO privileges — route_expired_order is permissionless;
# any funded account works. Omit for dry-run sweeps.
KEEPER_SECRET_KEY=

# TWAP order book (time-weighted execution)
TWAP_BOOK_CONTRACT_ID=

# Sushi pair registry (JSON): [{"tokenA","tokenB","pool","fee"}]
SUSHI_PAIRS=
TOKEN_PYUSD_SAC=

# Aqua pair registry mirror (for TWAP eligibility): [{"tokenA","tokenB","pool","fee"}]
AQUA_PAIRS=
