# Backend API URL — set this in Vercel Environment Variables
# After deploying the backend on Railway, paste the Railway URL here
# Example: https://atomicswap-backend-production.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:3001

# Network the app targets - signing is refused on any other network
# Mainnet: "Public Global Stellar Network ; September 2015"
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
